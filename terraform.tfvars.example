# Copy this file to terraform.tfvars and override values for your team.
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored so per-team values never get committed.
#
# Every value below is optional — omitting one uses the default in variables.tf
# (which reproduces the original quickstart).

# --- Project ----------------------------------------------------------------
project_id             = "my-app"          # immutable; changing recreates the project
project_display_name   = "My Application"
pg_version             = 17                 # 14, 15, 16, or 17
enable_pg_native_login = false

# purge_on_delete: how `terraform destroy` treats the project.
#   false (default) — soft delete with a 7-day retention window. Safer/recoverable;
#                     use for production and anything you might want back. The
#                     project_id slug stays reserved until the window expires.
#   true            — hard delete on destroy, frees the slug immediately.
# Recommended: keep false, and only set true in dev/CI where you tear down and
# re-create the same project_id often (a soft-deleted slug blocks re-apply until
# it expires). See "Deleting a project: soft delete vs. purge" in the README.
purge_on_delete        = false
# purge_on_delete      = true               # dev/CI: hard-delete on destroy, free the slug now

# --- Dev branch + endpoint --------------------------------------------------
create_dev_branch    = true                 # false = manage the project only
dev_branch_id        = "dev"
dev_branch_no_expiry = true
dev_endpoint_id      = "primary"
dev_endpoint_type    = "ENDPOINT_TYPE_READ_WRITE"  # or ENDPOINT_TYPE_READ_ONLY
