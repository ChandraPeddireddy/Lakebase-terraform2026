#!/usr/bin/env bash
# Databricks auth for Terraform. Copy to env.sh, fill in values, then:
#   source env.sh
# env.sh is gitignored so secrets are never committed.
#
# Set your workspace URL (from `databricks auth env` or ~/.databrickscfg):
export DATABRICKS_HOST="https://<your-workspace>.azuredatabricks.net"

# ---------------------------------------------------------------------------
# Pick ONE auth method below and fill it in.
# ---------------------------------------------------------------------------

# Option A — Personal Access Token (PAT). Simplest; authenticates as you.
# Create at: User Settings -> Developer -> Access tokens -> Generate new token.
# The value starts with "dapi". This is what most quickstarts use.
export DATABRICKS_TOKEN="dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Option B — OAuth M2M (service principal). Recommended for shared/CI use so
# automation isn't tied to a personal identity. To use this, comment out
# DATABRICKS_TOKEN above and uncomment the two lines below.
# Create an SP (Settings -> Identity and access -> Service principals),
# generate an OAuth secret, and grant it CAN MANAGE on the Lakebase project.
#   - Client ID is a UUID (e.g. a1b2c3d4-...)
#   - OAuth secret starts with "dose" (NOT "dapi" — that's a PAT)
# export DATABRICKS_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# export DATABRICKS_CLIENT_SECRET="doseXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
